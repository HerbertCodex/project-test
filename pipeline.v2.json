      "quick": {
        "model": "claude-sonnet-5",
        "effort": "low"
      },
      "deep": {
        "model": "claude-sonnet-5",
        "effort": "medium"
      }
    },
    {
      "provider": "claude",
      "role": "qa",
      "quick": {
        "model": "claude-sonnet-5",
        "effort": "low"
      },
      "deep": {
        "model": "claude-sonnet-5",
        "effort": "medium"
      }
    }
  ]
}
